# Merge into your own .env; never replace a configured password with this template.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mental_health_screening
DB_USER=YOUR_DATABASE_USER
DB_PASSWORD=''

# Optional: set once instead of entering a university for each student.
# If empty, the application uses the single university already in student records.
INSTITUTION_NAME=''

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AUTH_SESSION_MINUTES=30
INVITATION_HOURS=24
ML_SERVICE_URL=http://127.0.0.1:8010
